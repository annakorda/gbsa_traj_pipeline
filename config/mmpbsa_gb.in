# gmx_MMPBSA input file - GB only, matches the parameters used in the
# earlier c0/c3/c5/c9/exp0 production runs (unigbsa_em.ini [GBSA] section):
# igb=8, indi=4.0, exdi=80.0, saltcon=0.15
#
# unigbsa-traj's own built-in defaults are igb=2, extdiel=78.5 - NOT the
# same - so always pass this file with -f, don't rely on -m alone.

&general
  sys_name             = "GBSA_test"
  startframe           = 1
  endframe             = 9999999
  interval             = 1
  temperature          = 298.15
  verbose              = 1
/

&gb
  igb                  = 8
  intdiel              = 4.0
  extdiel              = 78.5
  saltcon              = 0.15
/
