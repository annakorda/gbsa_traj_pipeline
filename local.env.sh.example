# Optional per-user overrides for run_GBSA.sh.
#
# Copy this file to local.env.sh (gitignored, so pulls never touch it or
# make you re-edit anything) and uncomment whatever you actually need to
# override. repo_root does NOT need to be set here - it's derived
# automatically from SLURM_SUBMIT_DIR (see run_GBSA.sh).
#
# cp local.env.sh.example local.env.sh

# Only needed if you don't want to reuse Marta's already-built env - e.g.
# you ran `conda env create -f env/gbsa_env.yml -p ./gbsa_env` yourself:
# gbsa_env_path="${repo_root}/gbsa_env"
